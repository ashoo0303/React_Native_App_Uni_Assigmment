{
  "expo": {
    "name": "Aurelia Jewels",
    "slug": "App_Expo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "appexpo",
    "userInterfaceStyle": "automatic",
    "owner": "ayeshababar",
    "ios": {
      "bundleIdentifier": "com.ayeshababar.appexpo",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0d0c0a",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ayeshababar.appexpo"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Aurelia Jewels to choose a product photo from your library."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0d0c0a",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240,
          "dark": {
            "backgroundColor": "#0d0c0a",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "479c0bef-70cd-47da-8a38-42aee9e036b8"
      }
    }
  }
}
